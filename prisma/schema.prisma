generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  COORDINATOR
  ADMIN
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id                    String        @id @default(uuid()) @db.Uuid
  email                 String        @unique
  passwordHash          String        @map("password_hash")
  name                  String
  role                  Role          @default(MEMBER)
  balanceMinutes        Int           @default(0) @map("balance_minutes")
  hashedRefreshToken    String?       @map("hashed_refresh_token")
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  issuedBalanceGrants   BalanceGrant[] @relation("BalanceGrantIssuer")
  receivedBalanceGrants BalanceGrant[] @relation("BalanceGrantRecipient")
  services              Service[]     @relation("ServiceProvider")
  transactionsPayer     Transaction[] @relation("TransactionPayer")
  transactionsEarner    Transaction[] @relation("TransactionEarner")

  @@map("users")
}

model BalanceGrant {
  id          Int      @id @default(autoincrement())
  issuerId    String   @map("issuer_id") @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  amount      Int
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  issuer    User @relation("BalanceGrantIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  recipient User @relation("BalanceGrantRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([issuerId])
  @@index([recipientId])
  @@map("balance_grants")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  services Service[]

  @@map("categories")
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  durationMin Int      @map("duration_min")
  isActive    Boolean  @default(true) @map("is_active")
  providerId  String   @map("provider_id") @db.Uuid
  categoryId  Int      @map("category_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider    User          @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: Restrict)
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([providerId])
  @@index([categoryId])
  @@map("services")
}

model Transaction {
  id          Int               @id @default(autoincrement())
  fromUserId  String            @map("from_user_id") @db.Uuid
  toUserId    String            @map("to_user_id") @db.Uuid
  serviceId   Int               @map("service_id")
  minutes     Int
  status      TransactionStatus @default(PENDING)
  confirmedAt DateTime?         @map("confirmed_at")
  cancelledAt DateTime?         @map("cancelled_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  fromUser User    @relation("TransactionPayer", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser   User    @relation("TransactionEarner", fields: [toUserId], references: [id], onDelete: Restrict)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([serviceId])
  @@index([status])
  @@map("transactions")
}
